{
  "comments": { "lineComment": "#" },
  "brackets": [["(", ")"]],
  "autoClosingPairs": [
    { "open": "\"", "close": "\"" },
    { "open": "(", "close": ")" }
  ],
  "surroundingPairs": [
    { "open": "\"", "close": "\"" },
    { "open": "(", "close": ")" }
  ],
  "folding": {
    "markers": {
      "start": "^\\s*(define|class|if|while|count|loop|match|try)\\b",
      "end": "^\\s*end\\b"
    }
  }
}
