SB

define square with n as
    give back n times n.
end
define cube with n as
    give back n times n times n.
end
define absolute with n as
    if n is less than 0 then
        give back 0 minus n.
    end
    give back n.
end
define bigger with a and b as
    if a is greater than b then
        give back a.
    end
    give back b.
end
define smaller with a and b as
    if a is less than b then
        give back a.
    end
    give back b.
end
define clamp with v and lo and hi as
    if v is less than lo then give back lo. end
    if v is greater than hi then give back hi. end
    give back v.
end
define lerp with a and b and t as
    give back a plus (b minus a) times t.
end
define sign with v as
    if v is greater than 0 then give back 1. end
    if v is less than 0 then give back 0 minus 1. end
    give back 0.
end
define is_nan with v as
    ## NaN is the only value not equal to itself
    if v is not v then give back 1. end
    give back 0.
end

## — F batch: fib/factorial/gcd/lcm/round_to/average ———————————————————

define fib with n as
  if n is less than 2 then give back n. end
  set a to 0.
  set b to 1.
  count i from 2 to n then
    set c to a plus b.
    set a to b.
    set b to c.
  end
  give back b.
end

define factorial with n as
  set acc to 1.
  count i from 2 to n then
    set acc to acc times i.
  end
  give back acc.
end

define gcd with a and b as
  set x to absolute with a.
  set y to absolute with b.
  while y is greater than 0 then
    set t to y.
    set q to x divided evenly by y.
    set y to x minus q times y.
    set x to t.
  end
  give back x.
end

define lcm with a and b as
  set g to gcd with a and b.
  if g is 0 then give back 0. end
  set ag to a divided by g.
  give back absolute with ag times b.
end

define round_to with v and places as
  set mult to 1.
  count i from 1 to places then
    set mult to mult times 10.
  end
  set scaled to v times mult.
  set r to round with scaled.
  give back r divided by mult.
end

define average with xs as
  set n to length with xs.
  if n is 0 then give back 0. end
  set total to 0.
  loop el through xs then
    set total to total plus el.
  end
  give back total divided by n.
end
