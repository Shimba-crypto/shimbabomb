SB
## Ketiwe Layout Helpers
## Provides: center_x, center_y, grid_x, grid_y, pad, pad_rect

define center_x with win_w as
  give back win_w divided by 2.
end

define center_y with win_h as
  give back win_h divided by 2.
end

define grid_x with col and cell_w and padding as
  give back padding plus col times (cell_w plus padding).
end

define grid_y with row and cell_h and padding as
  give back padding plus row times (cell_h plus padding).
end

define pad with x and y and px and py as
  give back map with "x" and x plus px and "y" and y plus py.
end

define pad_rect with x and y and w and h and px and py and pr and pb as
  give back map with "x" and x plus px and "y" and y plus py and "w" and (w minus px) minus pr and "h" and (h minus py) minus pb.
end

define fill_window with color as
  ketiwe_rect(0, 0, 9999, 9999, color).
end

define draw_centered_text with text and win_w and win_h as
  set tw to (length with text) times 8.
  set tx to (win_w minus tw) divided by 2.
  set ty to (win_h divided by 2) plus 5.
  ketiwe_text(tx, ty, text).
end

define draw_button_row with labels and x and y and w and h and gap as
  set results to list with.
  set bx to x.
  loop lab through labels then
    set btn to ketiwe_button(bx, y, w, h, lab).
    add_to with results and btn.
    set bx to bx plus w plus gap.
  end
  give back results.
end

define inside with mx and my and x and y and w and h as
  if mx is greater than x or mx is x then
    if mx is less than x plus w then
      if my is greater than y or my is y then
        if my is less than y plus h then
          give back 1.
        end
      end
    end
  end
  give back 0.
end

define center_box with win_w and win_h and w and h as
  set cx to (win_w minus w) divided by 2.
  set cy to (win_h minus h) divided by 2.
  give back map with "x" and cx and "y" and cy and "w" and w and "h" and h.
end

define row_xs with x and w and gap and n as
  set out to list with.
  set bx to x.
  set step to w plus gap.
  count i from 0 to n minus 1 then
    add_to with out and bx.
    set bx to bx plus step.
  end
  give back out.
end

define col_ys with y and h and gap and n as
  set out to list with.
  set by to y.
  set step to h plus gap.
  count i from 0 to n minus 1 then
    add_to with out and by.
    set by to by plus step.
  end
  give back out.
end

define clamp_num with v and lo and hi as
  if v is less than lo then
    give back lo.
  end
  if v is greater than hi then
    give back hi.
  end
  give back v.
end
