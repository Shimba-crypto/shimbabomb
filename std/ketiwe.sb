SB
## Ketiwe Layout Helpers
## Provides: center_x, center_y, grid_x, grid_y, pad, pad_rect

define center_x with win_w as
  give back win_w / 2.
end

define center_y with win_h as
  give back win_h / 2.
end

define grid_x with col, cell_w, padding as
  give back padding + col * (cell_w + padding).
end

define grid_y with row, cell_h, padding as
  give back padding + row * (cell_h + padding).
end

define pad with x, y, px, py as
  give back { "x": x + px, "y": y + py }.
end

define pad_rect with x, y, w, h, px, py, pr, pb as
  give back { "x": x + px, "y": y + py, "w": w - px - pr, "h": h - py - pb }.
end

define fill_window with color as
  ketiwe_rect(0, 0, 9999, 9999, color).
end

define draw_centered_text with text, win_w, win_h as
  set tw to length of text * 8.
  set tx to (win_w - tw) / 2.
  set ty to win_h / 2 + 5.
  ketiwe_text(tx, ty, text).
end

define draw_button_row with labels, x, y, w, h, gap as
  set results to [].
  set i to 0.
  set bx to x.
  loop through labels
    set btn to ketiwe_button(bx, y, w, h, labels[i]).
    add results to btn.
    set bx to bx + w + gap.
    set i to i + 1.
  end
  give back results.
end
