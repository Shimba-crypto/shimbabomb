SB
# crypto — hashing via system tools

define md5 with text as
    set out to run with "printf '%s' '" plus text plus "' | md5sum | tr -d ' ' | cut -c1-32".
    give back trim with out.
end

define sha256 with text as
    set out to run with "printf '%s' '" plus text plus "' | sha256sum | tr -d ' ' | cut -c1-64".
    give back trim with out.
end

define random_hex with length as
    set base to "head -c200 /dev/urandom | sha256sum | tr -d ' ' | cut -c1-".
    set n1 to to_string with length.
    set cmd to base plus n1.
    set out to run with cmd.
    give back trim with out.
end

define uuid as
    give back trim with run with "cat /proc/sys/kernel/random/uuid 2>/dev/null || echo none".
end
