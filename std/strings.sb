# std/strings — helpers for text

define capitalize with s as
    if length with s is equal to 0 then
        give back s.
    end
    set first to upper with s[0].
    set rest to "".
    count i from 1 to length with s minus 1 then
        set rest to rest plus s[i].
    end
    give back first plus lower with rest.
end

define count_words with s as
    set parts to split with s and " ".
    give back length with parts.
end
define pad_left with s and n and ch as
    set out to s.
    while length with out is less than n then
        set out to ch plus out.
    end
    give back out.
end
define pad_right with s and n and ch as
    set out to s.
    while length with out is less than n then
        set out to out plus ch.
    end
    give back out.
end
define slug with s as
    set t to lower with s.
    set t to replace with t and " " and "-".
    give back t.
end
