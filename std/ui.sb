SB
# ============================================================
# ui.sb — ShimbaBomb UI component library
#   Emits themed HTML/CSS per DESIGN.md (dark technical dashboard)
#   All attributes single-quoted; tokens only, no raw hex outside css().
# ============================================================

# one-time stylesheet + page shell
define ui_css as
    give back "<style>
:root{--bg:#11111b;--surface:#1e1e2e;--overlay:#181825;--border:#45475a;--text:#cdd6f4;--muted:#a6adc8;--accent:#89b4fa;--accent-strong:#74a0f0;--success:#a6e3a1;--warning:#f9e2af;--danger:#f38ba8}
*{box-sizing:border-box;margin:0}
body{background:var(--bg);color:var(--text);font:16px/1.5 -apple-system,'Segoe UI',Roboto,Ubuntu,sans-serif;padding:24px;max-width:1100px;margin-inline:auto}
a{color:var(--accent);text-decoration:none}
a:hover{color:var(--accent-strong)}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:4px}
h1{font-size:28px;font-weight:700;letter-spacing:-.01em}
h2{font-size:20px;font-weight:600}
.mono{font-family:ui-monospace,'JetBrains Mono',Consolas,monospace}
.muted{color:var(--muted)}
.topbar{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:24px}
.brand{display:flex;align-items:center;gap:10px;font-weight:700;font-size:20px}
.logo{width:34px;height:34px;border-radius:10px;background:var(--surface);display:flex;align-items:center;justify-content:center;color:var(--accent);border:1px solid var(--border)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px}
.card{background:var(--surface);border:1px solid var(--border);border-radius:10px;padding:16px;box-shadow:0 1px 2px rgba(0,0,0,.35)}
.card h3{font-size:14px;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:.06em;margin-bottom:8px}
.stat-v{font-size:36px;font-weight:700;line-height:1.1}
.trend-up{color:var(--success)}.trend-dn{color:var(--danger)}
.btn{display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:10px 18px;border-radius:10px;background:var(--accent);color:#11111b;font-weight:600;border:1px solid transparent;cursor:pointer;transition:filter .12s ease-out, transform .12s ease-out}
.btn:hover{filter:brightness(1.08)}
.btn:active{transform:translateY(1px)}
.btn.ghost{background:transparent;color:var(--accent);border-color:var(--border)}
.badge{display:inline-block;padding:2px 10px;border-radius:999px;font-size:12px;font-weight:600;border:1px solid var(--border)}
.b-ok{color:var(--success);border-color:var(--success)}
.b-warn{color:var(--warning);border-color:var(--warning)}
.b-err{color:var(--danger);border-color:var(--danger)}
.rows{display:flex;flex-direction:column}
.row{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 8px;border-bottom:1px solid var(--border);min-height:44px}
.row:last-child{border-bottom:none}
.bar{height:10px;border-radius:999px;background:var(--overlay);overflow:hidden;margin-top:6px}
.bar>i{display:block;height:100%;background:var(--accent);border-radius:999px}
.kv{display:grid;grid-template-columns:auto 1fr;gap:8px 16px}
.kv dt{color:var(--muted)}
footer{margin-top:32px;color:var(--muted);font-size:14px;display:flex;justify-content:space-between}
@media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}}
</style>".
end.

define ui_logo_svg as
    give back "<svg width='18' height='18' viewBox='0 0 24 24' fill='none' aria-hidden='true'><path d='M13 2 4 14h6l-1 8 9-12h-6l1-8z' fill='currentColor'/></svg>".
end.

define ui_page with title and body_html as
    set css to ui_css with.
    set logo to ui_logo_svg with.
    set head to "<!DOCTYPE html><html lang='en'><head><meta charset='utf-8'>".
    set head to head plus "<meta name='viewport' content='width=device-width,initial-scale=1'>".
    set head to head plus "<title>" plus title plus "</title>".
    set head to head plus css.
    set open_body to "</head><body><header class='topbar'><div class='brand'><span class='logo'>".
    set brand_close to "</span>" plus title plus "</div></header>".
    set foot to "<footer><span>Built with ShimbaBomb</span><span>ui.sb v1</span></footer></body></html>".
    give back head plus open_body plus logo plus brand_close plus body_html plus foot.
end.

# ---------- components ----------

define ui_card with title and content_html as
    give back "<section class='card'><h3>" plus title plus "</h3>" plus content_html plus "</section>".
end.

define ui_stat with label and value and trend_text and trend_up as
    set cls to "trend-dn muted".
    if trend_up then
        set cls to "trend-up".
    end
    give back "<section class='card'><h3>" plus label plus "</h3><div class='stat-v mono'>" plus value plus "</div><span class='" plus cls plus "'>" plus trend_text plus "</span></section>".
end.

define ui_button with label and href as
    give back "<a class='btn' href='" plus href plus "'>" plus label plus "</a>".
end.

define ui_button_ghost with label and href as
    give back "<a class='btn ghost' href='" plus href plus "'>" plus label plus "</a>".
end.

define ui_badge with text and tone as
    # tone: ok | warn | err
    set cls to "b-ok".
    if tone is "warn" then
        set cls to "b-warn".
    end
    if tone is "err" then
        set cls to "b-err".
    end
    give back "<span class='badge " plus cls plus "'>" plus text plus "</span>".
end.

define ui_row with left_html and right_html as
    give back "<div class='row'><span>" plus left_html plus "</span><span>" plus right_html plus "</span></div>".
end.

define ui_rows_open as
    give back "<div class='rows card'>".
end.

define ui_rows_close as
    give back "</div>".
end.

define ui_bar with percent as
    give back "<div class='bar'><i style='width:" plus percent plus "%'></i></div>".
end.

define ui_meter with label and percent and right_text as
    set bar to ui_bar with percent.
    give back "<div><div class='row' style='padding:0;margin-bottom:4px'><span>" plus label plus "</span><span class='mono'>" plus right_text plus "</span></div>" plus bar plus "</div>".
end.

define ui_kv_open as
    give back "<dl class='kv card'>".
end.

define ui_kv_pair with key and value as
    give back "<dt>" plus key plus "</dt><dd class='mono'>" plus value plus "</dd>".
end.

define ui_kv_close as
    give back "</dl>".
end.

define ui_grid_open as
    give back "<div class='grid'>".
end.

define ui_grid_close as
    give back "</div>".
end.
