SB
## env — dotenv loader, 4GB-safe
## Provides: env_load, env_get, env_set

define env_load with path as
  set content to read_file with path.
  if length with content is 0 then
    give back map with.
  end
  set lines to split with content and "\n".
  set out to map with.
  loop ln through lines then
    set t to trim with ln.
    if length with t is 0 then
      set t to t.
    otherwise
      if item with 0 and t is "#" then
        set t to t.
      otherwise
        set eq to find with t and "=".
        if eq is greater than 0 then
          set k to trim with substr with t and 0 and eq.
          set v to trim with substr with t and eq plus 1 and length with t minus eq minus 1.
          ## strip quotes
          if item with 0 and v is "\"" then
            set v to substr with v and 1 and length with v minus 2.
          end
          set out[k] to v.
          run with "export " plus k plus "=\"" plus v plus "\" 2>/dev/null".
        end
      end
    end
  end
  give back out.
end

define env_get with name as
  give back run with "printenv " plus name plus " 2>/dev/null | tr -d '\n'".
end

define env_set2 with name and val as
  run with "export " plus name plus "=\"" plus val plus "\" 2>/dev/null".
  give back val.
end
