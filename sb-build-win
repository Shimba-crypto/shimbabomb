#!/bin/bash
# ============================================================
# sb-build-win — build a self-contained Windows x64 sb.exe (mingw)
#
#   ./sb-build-win            -> build/sb.exe
#
# The std/*.sb modules are embedded into the binary (SB_EMBED_STD), so
# `pls bring ...` works with no std/ directory on the target machine.
#
# Requires: x86_64-w64-mingw32-gcc, x86_64-w64-mingw32-windres, python3
#           apt: gcc-mingw-w64-x86-64 binutils-mingw-w64-x86-64
# ============================================================
set -e

SELF="$(readlink -f "$0")"
DIR="$(cd "$(dirname "$SELF")" && pwd)"
SRC="$DIR/src"
BUILD="$DIR/build"
CC="${CC:-x86_64-w64-mingw32-gcc}"
WINDRES="${WINDRES:-x86_64-w64-mingw32-windres}"
OUT="$BUILD/sb.exe"
GEN="$BUILD/embed_std.c"
RC_OBJ="$BUILD/sb_rc.o"

command -v "$CC" >/dev/null 2>&1 || { echo "sb-build-win: $CC not found (apt install gcc-mingw-w64-x86-64)"; exit 1; }
command -v python3 >/dev/null 2>&1 || { echo "sb-build-win: python3 not found"; exit 1; }

mkdir -p "$BUILD"

VER="$(cat "$DIR/VERSION" 2>/dev/null | tr -d '\r\n')"
[ -n "$VER" ] || VER="unknown"

echo "Generating embedded std ($(ls "$DIR"/std/*.sb | wc -l) modules), version $VER..."
python3 - "$DIR" "$GEN" <<'PY'
import glob, os, sys

root, out = sys.argv[1], sys.argv[2]
files = sorted(glob.glob(os.path.join(root, "std", "*.sb")))

def cstr(data):
    parts = []
    for b in data:
        if b == 0x5c: parts.append("\\\\")
        elif b == 0x22: parts.append('\\"')
        elif b == 0x0a: parts.append("\\n")
        elif b == 0x0d: parts.append("\\r")
        elif b == 0x09: parts.append("\\t")
        elif 32 <= b < 127: parts.append(chr(b))
        else: parts.append("\\%03o" % b)
    return '"' + "".join(parts) + '"'

names, srcs = [], []
for path in files:
    with open(path, "rb") as fh:
        srcs.append(cstr(fh.read()))
    names.append(cstr(os.path.basename(path)[:-3].encode()))

with open(out, "w", encoding="utf-8") as fh:
    fh.write("/* Generated by sb-build-win — do not edit. */\n")
    fh.write('#include "interpreter.h"\n\n')
    fh.write("static const char *sb_std_names[] = {\n")
    for n in names:
        fh.write("    %s,\n" % n)
    fh.write("};\n\n")
    fh.write("static const char *sb_std_srcs[] = {\n")
    for s in srcs:
        fh.write("    %s,\n" % s)
    fh.write("};\n\n")
    fh.write("void sb_embed_std(Interpreter *interp) {\n")
    fh.write("    unsigned n = (unsigned)(sizeof(sb_std_names) / sizeof(sb_std_names[0]));\n")
    fh.write("    for (unsigned i = 0; i < n; i++)\n")
    fh.write("        interp_embed_module(interp, sb_std_names[i], sb_std_srcs[i]);\n")
    fh.write("}\n")
PY

echo "Compiling Windows icon resource..."
if command -v "$WINDRES" >/dev/null 2>&1 && [ -f "$DIR/assets/sb.rc" ]; then
    ( cd "$DIR/assets" && "$WINDRES" sb.rc -I . -o "$RC_OBJ" )
else
    echo "  (windres or assets/sb.rc missing — building without the icon)"
    RC_OBJ=""
fi

echo "Building self-contained ShimbaBomb for Windows x64..."
"$CC" -std=c11 -O2 \
    -DSB_NO_GUI -DSB_NO_CURL -DSB_EMBED_STD \
    -DSB_VERSION="\"$VER\"" \
    -DSB_STD_DIR='"/c/shimbabomb/std"' -DSB_SRC_DIR='"/c/shimbabomb"' \
    -I"$SRC" -o "$OUT" \
    "$SRC/lexer.c" "$SRC/ast.c" "$SRC/value.c" "$SRC/parser.c" \
    "$SRC/ketiwe.c" "$SRC/interpreter.c" "$SRC/main.c" \
    "$GEN" $RC_OBJ \
    -lws2_32 -static -lm

echo "Done. Binary at $OUT"
